# ==============================================================================
# Sahaaya AI — Production Environment Configuration (.env.example)
# ==============================================================================
# Instructions: Copy this file to .env and adjust variables for your target deployment.

# Server & Network Configuration
PORT=8000
HOST=0.0.0.0
ENV=production

# CORS Security (comma-separated origins or * for open prototype)
# In production with a separate frontend domain (e.g., Vercel), specify:
# CORS_ORIGINS=https://sahaaya-ai.vercel.app,https://sahaaya-ai.onrender.com
CORS_ORIGINS=*

# Database Persistence Directory
DATA_DIR=app/static/data

# Optional: External Relational Database URL (PostgreSQL / SQLite)
# DATABASE_URL=sqlite:///./app/static/data/sahaaya.db

# Optional: Cloud AI / Speech Services (Reserved for future external providers)
# AI_SERVICE_API_KEY=
# SPEECH_RECOGNITION_KEY=
