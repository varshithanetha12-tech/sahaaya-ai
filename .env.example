# ==============================================================================
# SAHAAYA AI — Production Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env for local deployment.
# In Render cloud deployment, set these variables in the Render Dashboard under Environment.

# Server & Network Configuration
PORT=8000
HOST=0.0.0.0
ENV=production

# Public Deployed URLs (Render / Custom Domain)
# Example: https://sahaaya-ai.onrender.com
BACKEND_PUBLIC_URL=https://sahaaya-ai.onrender.com
FRONTEND_PUBLIC_URL=https://sahaaya-ai.onrender.com

# CORS Configuration (comma-separated domains or * for public access)
CORS_ORIGINS=*

# Database Persistence Configuration
# Render PostgreSQL Example: postgresql://sahaaya_user:password@dpg-xxxx.render.com/sahaaya_db
# SQLite Local Example: sqlite:///./app/static/data/sahaaya.db
DATA_DIR=app/static/data
# DATABASE_URL=postgresql://user:password@localhost:5432/sahaaya_db

# Optional AI & External Speech API Keys (Placeholders only)
# GEMINI_API_KEY=your_gemini_api_key_here
# SPEECH_SERVICE_KEY=your_speech_service_key_here
