{
  "version": 2,
  "builds": [
    {
      "src": "run.py",
      "use": "@vercel/python"
    },
    {
      "src": "app/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/app/static/$1"
    },
    {
      "src": "/manifest.json",
      "dest": "/app/static/manifest.json"
    },
    {
      "src": "/sw.js",
      "dest": "/app/static/sw.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "run.py"
    },
    {
      "src": "/(.*)",
      "dest": "run.py"
    }
  ]
}
